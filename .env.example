# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Optional: model fallback chain; on a quota (429) error the next model is used for the rest of the session
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
# Optional: simulate provider outages, comma-separated tool names
# MOCK_FAIL=search_flights,get_weather
